# Copy this file to .env and fill in your real values.
# Get a Gemini API key from https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_key_here

# Model name as listed in Google AI Studio. gemini-2.5-flash is a safe,
# widely-available default — check your AI Studio console for the
# latest available model name before deploying.
GEMINI_MODEL=gemini-3.6-flash

PORT=3000
NODE_ENV=production
